    "rbac",
    "acl",
    "permissions",
    "admin",
    "access-control"
  ],
  "license": "MIT",
  "author": "ipsoftware",
  "homepage": "https://github.com/ipsoftware/medusa-acl#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ipsoftware/medusa-acl.git"
  },
  "bugs": {
    "url": "https://github.com/ipsoftware/medusa-acl/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
